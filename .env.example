# As contas de sistema (pix_pending / card_receivable / crypto_pending) são
# criadas e resolvidas SOZINHAS pelo core-ledger na primeira cobrança de cada
# tipo -- não precisa configurar nada aqui. Confira em "Contas do sistema" no
# admin-panel. As linhas abaixo só existem pra quem quiser forçar um id
# específico manualmente (avançado/opcional).
# SYSTEM_PIX_PENDING_ACCOUNT=
# SYSTEM_CARD_RECEIVABLE_ACCOUNT=
# SYSTEM_CRYPTO_PENDING_ACCOUNT=

# Conta de lojista padrão, usada quando um serviço não recebe explicitamente
# qual conta deve receber o valor. Opcional -- normalmente cada cobrança já
# escolhe o cliente/lojista de destino nos formulários do admin-panel.
DEFAULT_MERCHANT_ACCOUNT=

# --- Provedores de PIX/cartão (interinos, até você ter licença própria) ---
# Pra TESTAR: deixe as chaves TEST-xxx/sk_test_xxx (ou use provider=sandbox,
# que nem precisa de chave nenhuma). O admin escolhe qual provedor está
# ativo em runtime, sem redeploy: PUT /admin/settings/providers/{pix,card}
# (ou pela tela "Provedores" no admin-panel).
#
# Pra ir PRA PRODUÇÃO com dinheiro de verdade (Mercado Pago):
#   1. Gere o token de PRODUÇÃO (não o de teste) no seu painel do Mercado
#      Pago > sua aplicação > Credenciais de produção.
#   2. Configure a assinatura secreta do webhook (mesmo painel > Webhooks >
#      "Assinatura secreta") e cole em MERCADOPAGO_WEBHOOK_SECRET abaixo --
#      SEM isso, o serviço recusa qualquer webhook (por segurança: sem
#      assinatura verificada, não dá pra confiar que a notificação veio
#      mesmo do Mercado Pago, então nenhum pagamento é liquidado sozinho).
#   3. Configure a URL de webhook no Mercado Pago apontando pra
#      https://SEU-DOMINIO/webhook/mercadopago (domínio do pix-service).
#   4. No admin-panel > Provedores, troque PIX pra "mercadopago".
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=
PAGARME_SECRET_KEY=sk_test_xxxxxxxx
PAGARME_WEBHOOK_SECRET=

# --- Cripto (sem provedor terceiro, endereços próprios via HD wallet) -----
# ⚠️ Em produção, NÃO use uma mnemônica com fundos reais direto num servidor
# exposto à internet — ver o aviso de segurança em services/crypto-service/wallet.py
HD_WALLET_MNEMONIC="test test test test test test test test test test test junk"
WEB3_RPC_URL=https://polygon-rpc.com
MATIC_BRL_RATE=2.50
USDT_BRL_RATE=5.50

# --- Painel admin (web) -----------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_PANEL_SECRET=gere-uma-string-aleatoria-longa
CUSTOMER_PORTAL_SECRET=gere-outra-string-aleatoria-longa

# --- Segurança dos cookies de sessão ----------------------------------------
# "true" (padrão) exige HTTPS pro cookie de sessão voltar -- é o que você
# quer em produção (EasyPanel já serve tudo por HTTPS). Só mude pra "false"
# rodando local em http://localhost (o docker-compose.override.yml já faz
# isso sozinho pra admin-panel e customer-portal).
FORCE_HTTPS_COOKIES=true
