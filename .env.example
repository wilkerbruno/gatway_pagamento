# Contas de sistema e conta de lojista padrão, criadas via
# scripts/bootstrap_sandbox.sh (ele imprime estas linhas prontas).
SYSTEM_PIX_PENDING_ACCOUNT=
SYSTEM_CARD_RECEIVABLE_ACCOUNT=
SYSTEM_CRYPTO_PENDING_ACCOUNT=
DEFAULT_MERCHANT_ACCOUNT=

# --- Provedores de PIX/cartão (interinos, até você ter licença própria) ---
# Chaves de TESTE/sandbox das respectivas plataformas. O admin escolhe qual
# está ativo em runtime via core-ledger: PUT /admin/settings/providers/{pix,card}
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx
PAGARME_SECRET_KEY=sk_test_xxxxxxxx

# --- Cripto (sem provedor terceiro, endereços próprios via HD wallet) -----
# ⚠️ Em produção, NÃO use uma mnemônica com fundos reais direto num servidor
# exposto à internet — ver o aviso de segurança em services/crypto-service/wallet.py
HD_WALLET_MNEMONIC="test test test test test test test test test test test junk"
WEB3_RPC_URL=https://polygon-rpc.com
MATIC_BRL_RATE=2.50
USDT_BRL_RATE=5.50

# --- Painel admin (web) -----------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_PANEL_SECRET=gere-uma-string-aleatoria-longa
